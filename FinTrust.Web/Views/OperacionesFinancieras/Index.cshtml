@model IEnumerable<FinTrust.Web.Models.OperacionFinanciera>

@{
    ViewData["Title"] = "Operaciones financieras";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">Operaciones financieras</h1>
        <p class="text-muted mb-0">Registro de depósitos, retiros, transferencias y pagos.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Registrar operación</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Todavía no existen operaciones registradas.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Fecha y hora</th>
                    <th>Tipo</th>
                    <th>Socio ejecutor</th>
                    <th class="text-end">Monto</th>
                    <th>Referencia</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var socio = item.SocioEjecutor is null
                        ? "Sin socio"
                        : $"{item.SocioEjecutor.CodigoSocio} - {item.SocioEjecutor.Persona.Nombres} {item.SocioEjecutor.Persona.Apellidos}";

                    <tr>
                        <td>@item.OperacionId</td>
                        <td>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="badge text-bg-secondary">@item.TipoOperacion</span></td>
                        <td>@socio</td>
                        <td class="text-end">Bs @item.Monto.ToString("N2")</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Referencia) ? "-" : item.Referencia)</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.OperacionId" class="btn btn-sm btn-outline-secondary">Detalles</a>
                            <a asp-action="Edit" asp-route-id="@item.OperacionId" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.OperacionId" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
