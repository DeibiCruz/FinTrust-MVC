@model FinTrust.Web.ViewModels.ReportePrestamoViewModel

@{
    ViewData["Title"] = "Reporte de Préstamos";
}

<h1>Reporte de Préstamos</h1>

<form asp-action="Index" method="get" class="row g-3 mb-4">
    <div class="col-md-3">
        <label asp-for="NumeroPrestamo" class="form-label">Número de préstamo</label>
        <input asp-for="NumeroPrestamo"
               class="form-control"
               placeholder="Ej.: PRE-001" />
    </div>

    <div class="col-md-3">
        <label asp-for="Estado" class="form-label">Estado</label>
        <select asp-for="Estado"
                asp-items="Model.Estados"
                class="form-select">
            <option value="">Todos</option>
        </select>
    </div>

    <div class="col-md-4">
        <label asp-for="SocioId" class="form-label">Socio solicitante</label>
        <select asp-for="SocioId"
                asp-items="Model.Socios"
                class="form-select">
            <option value="">Todos</option>
        </select>
    </div>

    <div class="col-md-2 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary">
            Buscar
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Limpiar filtros
        </a>
    </div>
</form>

<h4>Resumen general</h4>

<div class="row mb-4">
    <div class="col-md">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Préstamos encontrados</div>
                <strong>@Model.TotalPrestamos</strong>
            </div>
        </div>
    </div>
    <div class="col-md">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Capital total</div>
                <strong>@Model.CapitalTotal.ToString("N2") Bs</strong>
            </div>
        </div>
    </div>
    <div class="col-md">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Total programado en cuotas</div>
                <strong>@Model.TotalProgramado.ToString("N2") Bs</strong>
            </div>
        </div>
    </div>
    <div class="col-md">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Total pagado</div>
                <strong>@Model.TotalPagado.ToString("N2") Bs</strong>
            </div>
        </div>
    </div>
    <div class="col-md">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Saldo pendiente de cuotas</div>
                <strong>@Model.SaldoPendiente.ToString("N2") Bs</strong>
            </div>
        </div>
    </div>
</div>

@if (!Model.Prestamos.Any())
{
    <div class="alert alert-info">
        No se encontraron préstamos con los filtros seleccionados.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Número de préstamo</th>
                    <th>Socio solicitante</th>
                    <th>Capital</th>
                    <th>Tasa anual</th>
                    <th>Plazo (meses)</th>
                    <th>Fecha de solicitud</th>
                    <th>Estado</th>
                    <th>Cuotas</th>
                    <th>Total programado</th>
                    <th>Total pagado</th>
                    <th>Saldo pendiente de cuotas</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Prestamos)
                {
                    <tr>
                        <td>@item.NumeroPrestamo</td>
                        <td>@item.CodigoSocio - @item.NombreSocio</td>
                        <td>@item.Capital.ToString("N2") Bs</td>
                        <td>@item.TasaInteresAnual.ToString("N2") %</td>
                        <td>@item.PlazoMeses</td>
                        <td>@item.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                        <td>@item.Estado</td>
                        <td>@item.CantidadCuotas</td>
                        <td>@item.TotalProgramado.ToString("N2") Bs</td>
                        <td>@item.TotalPagado.ToString("N2") Bs</td>
                        <td>
                            @item.SaldoPendiente.ToString("N2") Bs
                            @if (item.CantidadCuotas == 0)
                            {
                                <br />
                                <small class="text-muted">Sin cronograma de cuotas *</small>
                            }
                        </td>
                        <td>
                            <a asp-action="Details"
                               asp-route-id="@item.PrestamoId">Detalles</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Prestamos.Any(p => p.CantidadCuotas == 0))
    {
        <p class="text-muted">
            * El saldo calculado a partir de las cuotas es 0,00 Bs porque el préstamo
            todavía no tiene un cronograma de cuotas registrado. Esto no significa
            que la deuda del préstamo sea cero.
        </p>
    }
}
