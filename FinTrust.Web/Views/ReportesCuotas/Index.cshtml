@model FinTrust.Web.ViewModels.ReporteCuotasViewModel

@{
    ViewData["Title"] = "Reporte de Cuotas";
}

<h1>Reporte de Cuotas</h1>

<p class="text-muted">
    Cuotas vencidas, por vencer y pagadas. Fecha de referencia: @Model.FechaReporte.ToString("dd/MM/yyyy").
</p>

<form asp-action="Index" method="get" class="row g-3 mb-4">
    <div class="col-md-2">
        <label asp-for="FechaDesde" class="form-label">Vencimiento desde</label>
        <input asp-for="FechaDesde" type="date" class="form-control" />
    </div>

    <div class="col-md-2">
        <label asp-for="FechaHasta" class="form-label">Vencimiento hasta</label>
        <input asp-for="FechaHasta" type="date" class="form-control" />
    </div>

    <div class="col-md-3">
        <label asp-for="Situacion" class="form-label">Situación</label>
        <select asp-for="Situacion"
                asp-items="Model.Situaciones"
                class="form-select">
        </select>
    </div>

    <div class="col-md-3">
        <label asp-for="SocioId" class="form-label">Socio</label>
        <select asp-for="SocioId"
                asp-items="Model.Socios"
                class="form-select">
            <option value="">Todos</option>
        </select>
    </div>

    <div class="col-md-2 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary">
            Buscar
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Limpiar filtros
        </a>
    </div>
</form>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<h4>Resumen general</h4>

<div class="row mb-4">
    <div class="col-md">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Cuotas encontradas</div>
                <strong>@Model.CantidadCuotas</strong>
            </div>
        </div>
    </div>
    <div class="col-md">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Total programado</div>
                <strong>@Model.TotalProgramado.ToString("N2") Bs</strong>
            </div>
        </div>
    </div>
    <div class="col-md">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Total pagado</div>
                <strong>@Model.TotalPagado.ToString("N2") Bs</strong>
            </div>
        </div>
    </div>
    <div class="col-md">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Saldo pendiente</div>
                <strong>@Model.SaldoPendiente.ToString("N2") Bs</strong>
            </div>
        </div>
    </div>
    <div class="col-md">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Cuotas vencidas</div>
                <strong>@Model.CantidadVencidas (@Model.SaldoVencido.ToString("N2") Bs)</strong>
            </div>
        </div>
    </div>
</div>

@if (!Model.Cuotas.Any())
{
    <div class="alert alert-info">
        No se encontraron cuotas con los filtros seleccionados.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Préstamo</th>
                    <th>Socio</th>
                    <th>Número de cuota</th>
                    <th>Fecha de vencimiento</th>
                    <th>Total de la cuota</th>
                    <th>Total pagado</th>
                    <th>Saldo pendiente</th>
                    <th>Días de atraso</th>
                    <th>Situación</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Cuotas)
                {
                    <tr>
                        <td>@item.NumeroPrestamo</td>
                        <td>@item.CodigoSocio - @item.NombreSocio</td>
                        <td>@item.NumeroCuota</td>
                        <td>@item.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                        <td>@item.TotalCuota.ToString("N2") Bs</td>
                        <td>@item.TotalPagado.ToString("N2") Bs</td>
                        <td>@item.SaldoPendiente.ToString("N2") Bs</td>
                        <td>@(item.EstaVencida ? item.DiasAtraso.ToString() : "-")</td>
                        <td>
                            @if (item.Situacion == "Vencida")
                            {
                                <span class="text-danger">@item.Situacion</span>
                            }
                            else
                            {
                                @item.Situacion
                            }
                        </td>
                        <td>
                            <a asp-controller="ReportesPrestamos"
                               asp-action="Details"
                               asp-route-id="@item.PrestamoId">Ver préstamo</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
