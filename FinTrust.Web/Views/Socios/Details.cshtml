@model FinTrust.Web.Models.Socio

@{
    ViewData["Title"] = "Detalles del socio";
}

<h1>Detalles del socio</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">Persona</dt>
    <dd class="col-sm-9">@Model.Persona?.Nombres @Model.Persona?.Apellidos</dd>

    <dt class="col-sm-3">Documento de identidad</dt>
    <dd class="col-sm-9">@Model.Persona?.DocumentoIdentidad</dd>

    <dt class="col-sm-3">Código de socio</dt>
    <dd class="col-sm-9">@Model.CodigoSocio</dd>

    <dt class="col-sm-3">Fecha de ingreso</dt>
    <dd class="col-sm-9">@Model.FechaIngreso.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@Model.Estado</dd>
</dl>

<div>
    <a asp-action="Edit" asp-route-id="@Model.SocioId" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>
