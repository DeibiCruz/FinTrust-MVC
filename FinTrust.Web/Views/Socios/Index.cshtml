@model IEnumerable<FinTrust.Web.Models.Socio>

@{
    ViewData["Title"] = "Socios";
}

<div class="page-heading">
    <div>
        <span class="eyebrow">Gestión de asociados</span>
        <h1>Socios</h1>
        <p class="page-subtitle">Consulta y administra los socios registrados en FinTrust.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Crear socio</a>
</div>

<div class="table-card">
<table class="table table-hover align-middle mb-0">
    <thead>
        <tr>
            <th>
                Persona
            </th>
            <th>
                Código de socio
            </th>
            <th>
                Fecha de ingreso
            </th>
            <th>
                Estado
            </th>
            <th>
                Cuentas
            </th>
            <th>
                Operaciones
            </th>
            <th>
                Datos de persona
            </th>
            <th>
                Préstamos
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.PersonaId)
                </td>
                <td>
                    @Html.DisplayFor(model => item.CodigoSocio)
                </td>
                <td>
                    @Html.DisplayFor(model => item.FechaIngreso)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Estado)
                </td>
                <td>
                    @Html.DisplayFor(model => item.CuentaSocios)
                </td>
                <td>
                    @Html.DisplayFor(model => item.OperacionFinancieras)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Persona)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Prestamos)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.SocioId" class="action-link">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.SocioId" class="action-link">Ver</a>
                    <a asp-action="Delete" asp-route-id="@item.SocioId" class="action-link action-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
