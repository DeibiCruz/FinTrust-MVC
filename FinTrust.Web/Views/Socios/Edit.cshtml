@model FinTrust.Web.Models.Socio

@{
    ViewData["Title"] = "Editar socio";
}

<h1>Editar socio</h1>
<hr />

<form asp-action="Edit">
    <div asp-validation-summary="All" class="text-danger"></div>

    <input type="hidden" asp-for="SocioId" />

    <div class="form-group">
        <label asp-for="PersonaId" class="control-label">Persona</label>
        <select asp-for="PersonaId" asp-items="ViewBag.Personas" class="form-select" required>
            <option value="">Seleccionar persona</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="CodigoSocio" class="control-label"></label>
        <input asp-for="CodigoSocio" class="form-control" maxlength="25" required />
    </div>

    <div class="form-group">
        <label asp-for="FechaIngreso" class="control-label"></label>
        <input asp-for="FechaIngreso" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Estado" class="control-label"></label>
        <select asp-for="Estado" class="form-select">
            <option value="ACTIVO">Activo</option>
            <option value="INACTIVO">Inactivo</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary mt-3">
        Guardar cambios
    </button>
</form>

<a asp-action="Index" class="btn btn-secondary mt-3">Volver</a>
