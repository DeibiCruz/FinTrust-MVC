@model FinTrust.Web.Models.Persona

@{
    ViewData["Title"] = "Eliminar persona";
}

<h1>Eliminar persona</h1>

<h3>¿Está seguro de que desea eliminar esta persona?</h3>
<div asp-validation-summary="All" class="text-danger"></div>
<div>
    <h4>Persona</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DocumentoIdentidad)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DocumentoIdentidad)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nombres)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nombres)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Apellidos)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Apellidos)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Telefono)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Telefono)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Correo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Correo)
        </dd>
    </dl>
    <form asp-controller="Personas" asp-action="Delete" asp-route-id="@Model.PersonaId" method="post">
        <input type="hidden" name="id" value="@Model.PersonaId" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
