@model FinTrust.Web.Models.PagoCuotum

@{
    ViewData["Title"] = "Registrar pago";
    bool hayCuotas = ViewBag.HayCuotas == true;
    bool hayOperaciones = ViewBag.HayOperaciones == true;
}

<h1>Registrar pago</h1>

<hr />

@if (!hayOperaciones)
{
    <div class="alert alert-warning">
        No existen operaciones financieras de tipo PAGO_CUOTA disponibles para registrar pagos.
    </div>
}

@if (!hayCuotas)
{
    <div class="alert alert-warning">
        No existen cuotas de préstamos desembolsados para aplicar pagos.
    </div>
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="CuotaId" class="form-label">Cuota</label>
                <select asp-for="CuotaId"
                        asp-items="ViewBag.CuotaId"
                        class="form-select">
                    <option value="">Seleccione una cuota</option>
                </select>
                <span asp-validation-for="CuotaId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="OperacionId" class="form-label">
                    Operación financiera
                </label>
                <select asp-for="OperacionId"
                        asp-items="ViewBag.OperacionId"
                        class="form-select">
                    <option value="">Seleccione una operación</option>
                </select>
                <span asp-validation-for="OperacionId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MontoAplicado" class="form-label">
                    Monto aplicado (Bs)
                </label>
                <input asp-for="MontoAplicado"
                       type="number"
                       step="0.01"
                       min="0.01"
                       class="form-control" />
                <span asp-validation-for="MontoAplicado" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaPago" class="form-label">
                    Fecha de pago
                </label>
                <input asp-for="FechaPago"
                       type="datetime-local"
                       class="form-control" />
                <span asp-validation-for="FechaPago" class="text-danger"></span>
            </div>

            @if (hayCuotas && hayOperaciones)
            {
                <button type="submit" class="btn btn-primary">
                    Guardar
                </button>
            }
            else
            {
                <button type="submit" class="btn btn-primary" disabled>
                    Guardar
                </button>
            }

            <a asp-action="Index" class="btn btn-secondary">
                Volver
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
