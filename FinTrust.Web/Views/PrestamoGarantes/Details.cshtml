@model FinTrust.Web.Models.PrestamoGarante

@{
    ViewData["Title"] = "Detalles del garante";
}

<h1>Detalles del garante</h1>

<hr />

<dl class="row">
    <dt class="col-sm-3">
        Préstamo
    </dt>
    <dd class="col-sm-9">
        @Model.Prestamo?.NumeroPrestamo
    </dd>

    <dt class="col-sm-3">
        Persona garante
    </dt>
    <dd class="col-sm-9">
        @Model.PersonaGarante?.Nombres
        @Model.PersonaGarante?.Apellidos
    </dd>

    <dt class="col-sm-3">
        Tipo de responsabilidad
    </dt>
    <dd class="col-sm-9">
        @Model.TipoResponsabilidad
    </dd>

    <dt class="col-sm-3">
        Monto respaldado
    </dt>
    <dd class="col-sm-9">
        @Model.MontoRespaldado?.ToString("N2") Bs
    </dd>

    <dt class="col-sm-3">
        Fecha de aceptación
    </dt>
    <dd class="col-sm-9">
        @Model.FechaAceptacion
    </dd>
</dl>

<div>
    <a asp-action="Edit"
       asp-route-prestamoId="@Model.PrestamoId"
       asp-route-personaGaranteId="@Model.PersonaGaranteId"
       class="btn btn-primary">
        Editar
    </a>

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>
</div>
