@model FinTrust.Web.Models.PrestamoGarante

@{
    ViewData["Title"] = "Editar garante";
}

<h1>Editar garante</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit"
              asp-route-prestamoId="@Model.PrestamoId"
              asp-route-personaGaranteId="@Model.PersonaGaranteId"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <input type="hidden" asp-for="PrestamoId" />
            <input type="hidden" asp-for="PersonaGaranteId" />

            <div class="mb-3">
                <label class="form-label">Préstamo</label>
                <input class="form-control"
                       value="@Model.PrestamoId"
                       readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Persona garante</label>
                <input class="form-control"
                       value="@Model.PersonaGaranteId"
                       readonly />
            </div>

            <div class="mb-3">
                <label asp-for="TipoResponsabilidad"
                       class="form-label">
                    Tipo de responsabilidad
                </label>

                <select asp-for="TipoResponsabilidad"
                        class="form-select">
                    <option value="SOLIDARIA">SOLIDARIA</option>
                    <option value="SUBSIDIARIA">SUBSIDIARIA</option>
                </select>

                <span asp-validation-for="TipoResponsabilidad"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MontoRespaldado"
                       class="form-label">
                    Monto respaldado (Bs)
                </label>

                <input asp-for="MontoRespaldado"
                       type="number"
                       step="0.01"
                       min="0.01"
                       class="form-control" />

                <span asp-validation-for="MontoRespaldado"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaAceptacion"
                       class="form-label">
                    Fecha de aceptación
                </label>

                <input asp-for="FechaAceptacion"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="FechaAceptacion"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Guardar cambios
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Volver
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
