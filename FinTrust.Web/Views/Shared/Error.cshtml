@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error</h1>
<h2 class="text-danger">Ocurrió un error al procesar la solicitud.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Id de la solicitud:</strong> <code>@Model.RequestId</code>
    </p>
}

<p>Vuelve a intentarlo. Si el problema continúa, comunícate con el administrador del sistema.</p>

<a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Volver al inicio</a>
