@model FinTrust.Web.Models.CuotaPrestamo

@{
    ViewData["Title"] = "Editar cuota";
}

<h1>Editar cuota</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit"
              asp-route-id="@Model.CuotaId"
              method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="CuotaId" />

            <div class="mb-3">
                <label asp-for="PrestamoId" class="form-label">Préstamo</label>
                <select asp-for="PrestamoId"
                        asp-items="ViewBag.PrestamoId"
                        class="form-select"></select>
                <span asp-validation-for="PrestamoId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NumeroCuota" class="form-label">
                    Número de cuota
                </label>
                <input asp-for="NumeroCuota"
                       type="number"
                       min="1"
                       max="32767"
                       step="1"
                       class="form-control" />
                <span asp-validation-for="NumeroCuota" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaVencimiento" class="form-label">
                    Fecha de vencimiento
                </label>
                <input asp-for="FechaVencimiento"
                       type="date"
                       class="form-control" />
                <span asp-validation-for="FechaVencimiento" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CapitalProgramado" class="form-label">
                    Capital programado (Bs)
                </label>
                <input asp-for="CapitalProgramado"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control" />
                <span asp-validation-for="CapitalProgramado" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="InteresProgramado" class="form-label">
                    Interés programado (Bs)
                </label>
                <input asp-for="InteresProgramado"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control" />
                <span asp-validation-for="InteresProgramado" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Estado</label>
                <input value="@Model.Estado"
                       class="form-control"
                       readonly />
            </div>

            <button type="submit" class="btn btn-primary">
                Guardar cambios
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Volver
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
