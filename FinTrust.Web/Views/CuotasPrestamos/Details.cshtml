@model FinTrust.Web.Models.CuotaPrestamo

@{
    ViewData["Title"] = "Detalles de cuota";
}

<h1>Detalles de cuota</h1>

<hr />

<dl class="row">
    <dt class="col-sm-3">Préstamo</dt>
    <dd class="col-sm-9">@Model.Prestamo?.NumeroPrestamo</dd>

    <dt class="col-sm-3">Número de cuota</dt>
    <dd class="col-sm-9">@Model.NumeroCuota</dd>

    <dt class="col-sm-3">Fecha de vencimiento</dt>
    <dd class="col-sm-9">@Model.FechaVencimiento.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-3">Capital programado</dt>
    <dd class="col-sm-9">@Model.CapitalProgramado.ToString("N2") Bs</dd>

    <dt class="col-sm-3">Interés programado</dt>
    <dd class="col-sm-9">@Model.InteresProgramado.ToString("N2") Bs</dd>

    <dt class="col-sm-3">Total</dt>
    <dd class="col-sm-9">@((Model.CapitalProgramado + Model.InteresProgramado).ToString("N2")) Bs</dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@Model.Estado</dd>

    <dt class="col-sm-3">Pagos registrados</dt>
    <dd class="col-sm-9">@ViewBag.CantidadPagos</dd>
</dl>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model.CuotaId"
       class="btn btn-primary">
        Editar
    </a>

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>
</div>
