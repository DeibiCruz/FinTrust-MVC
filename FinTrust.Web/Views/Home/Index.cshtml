@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center">
    <h1 class="display-4">FinTrust</h1>
    <p>Registra una persona, crea su perfil de socio y asóciala a una cuenta.</p>
    <a class="btn btn-primary m-2" asp-controller="Personas" asp-action="Index">Personas</a>
    <a class="btn btn-primary m-2" asp-controller="Socios" asp-action="Index">Socios</a>
    <a class="btn btn-primary m-2" asp-controller="Cuentas" asp-action="Index">Cuentas</a>
    <a class="btn btn-primary m-2" asp-controller="OperacionesFinancieras" asp-action="Index">Operaciones</a>

    <p class="mt-4">Gestiona los préstamos, sus garantías, cuotas y pagos.</p>
    <a class="btn btn-primary m-2" asp-controller="Prestamos" asp-action="Index">Préstamos</a>
    <a class="btn btn-primary m-2" asp-controller="PrestamoGarantes" asp-action="Index">Garantes</a>
    <a class="btn btn-primary m-2" asp-controller="GarantiasReales" asp-action="Index">Garantías reales</a>
    <a class="btn btn-primary m-2" asp-controller="CuotasPrestamos" asp-action="Index">Cuotas</a>
    <a class="btn btn-primary m-2" asp-controller="PagosCuotas" asp-action="Index">Pagos de cuotas</a>
    <a class="btn btn-primary m-2" asp-controller="ReportesPrestamos" asp-action="Index">Reporte de préstamos</a>
    <a class="btn btn-primary m-2" asp-controller="ReportesCuotas" asp-action="Index">Reporte de cuotas</a>
</div>
