@model FinTrust.Web.Models.Cuentum

@{
    ViewData["Title"] = "Editar cuenta";
}

<h1>Editar cuenta</h1>
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.CuentaId" method="post">
            <input type="hidden" asp-for="CuentaId" />
            <partial name="_Formulario" model="Model" />
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Details" asp-route-id="@Model.CuentaId" class="btn btn-secondary">Volver</a>
        </form>
    </div>
</div>
